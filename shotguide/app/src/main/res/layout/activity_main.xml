<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
<androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent" app:implementationMode="compatible" app:scaleType="fillCenter"/>
<com.yve.shotguide.GuidanceOverlayView android:id="@+id/overlayView" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_margin="14dp" android:background="@drawable/panel_bg" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SHOT COACH" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"/>
<TextView android:id="@+id/lensText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="กำลังวิเคราะห์ฉาก…" android:textColor="#FFFFFFFF" android:textSize="21sp" android:textStyle="bold"/>
<TextView android:id="@+id/adviceText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="3" android:text="จัดเฟรมให้นิ่ง แล้วระบบจะช่วยแนะนำ" android:textColor="#E6FFFFFF" android:textSize="14sp"/>
<TextView android:id="@+id/debugText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#AFFFFFFF" android:textSize="11sp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingBottom="18dp">
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:fillViewport="false" android:paddingHorizontal="10dp" android:scrollbars="none">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
<Button android:id="@+id/lens15" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_margin="3dp" android:background="@drawable/lens_button" android:text="15" android:textColor="#FFFFFFFF"/>
<Button android:id="@+id/lens23" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_margin="3dp" android:background="@drawable/lens_button" android:text="23" android:textColor="#FFFFFFFF"/>
<Button android:id="@+id/lens35" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_margin="3dp" android:background="@drawable/lens_button" android:text="35" android:textColor="#FFFFFFFF"/>
<Button android:id="@+id/lens46" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_margin="3dp" android:background="@drawable/lens_button" android:text="46" android:textColor="#FFFFFFFF"/>
<Button android:id="@+id/lens75" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_margin="3dp" android:background="@drawable/lens_button" android:text="75" android:textColor="#FFFFFFFF"/>
<Button android:id="@+id/lens115" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_margin="3dp" android:background="@drawable/lens_button" android:text="115" android:textColor="#FFFFFFFF"/>
</LinearLayout></HorizontalScrollView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
<Button android:id="@+id/applyRecommendedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginEnd="14dp" android:background="@drawable/lens_button" android:text="ใช้เลนส์แนะนำ" android:textColor="#FFFFFFFF" android:textStyle="bold"/>
<Button android:id="@+id/shutterButton" android:layout_width="76dp" android:layout_height="64dp" android:background="@drawable/lens_button" android:text="ถ่าย" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout></LinearLayout>
</FrameLayout>
